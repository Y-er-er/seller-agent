# ============================================================
# 环境变量模板（纪律 9：密钥 / API / 模型名称一律入 .env，代码只做调用）
# 复制为 .env 后填写真实值；.env 不得提交到版本库。
# ============================================================

# ---------- 模型服务商 ----------
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# ---------- 模型名称 ----------
# ⚠️ 文本模型必须选「纯文本模型」。langchain 的 ChatTongyi 只按「名字里是否含 vl」推断端点：
#    多模态模型（qwen3.7-plus / qwen3.8-max / qwen3.8-flash）名字不含 vl，
#    会被误判到 text-generation 端点 → 稳定 400 InvalidParameter: url error。
#    qwen3.7-max 为官方明确标注的纯文本模型，支持 Function Calling。
#    视觉模型走 MultiModalConversation（多模态端点），配 qwen3-vl-plus 正确。
LLM_TEXT_MODEL=qwen3.7-max        # 文本主模型（纯文本，支持 Function Calling）
LLM_VISION_MODEL=qwen3-vl-plus    # 视觉问答（举证图片理解，走多模态端点）

# ---------- 功能开关 ----------
# 模型调用是**正常运行能力**：成本是配置项（见下方「成本闸门」），不是设计前提。
# ⚠️ 开启后，任何走对话 / 问答润色 / 视觉的请求都会产生**真实计费**调用。
LLM_ENABLED=true
SHADOW_MODE=true                  # true：影子模式，dispose 只记录不执行（**资金安全闸门，非成本项**）

# ---------- 视觉理解（举证图片，**计费**）----------
# 只有 LLM_ENABLED=true 且 VISION_MAX_IMAGES>0 时才真正调用；三项均为成本/合规护栏。
VISION_MAX_IMAGES=5               # 单笔申请最多送模型的图片张数（硬上限；设 0 即彻底关闭视觉）
VISION_TIMEOUT=8                  # 单次视觉调用超时（秒），超时即降级，不阻塞判定
VISION_INCLUDE_BUYER_NOTE=false   # 合规控制（**非成本项**）：买家留言涉个人信息出境，默认不送

# ---------- 口径问答（客服释疑，**不参与资格判定**）----------
# 基线走确定性解释（规则命中 + 审计事实）与标准口径库；QA_LLM_POLISH=true 时用模型润色措辞（计费）。
QA_LLM_POLISH=true
QA_MAX_SOURCES=3                  # 单次回答最多引用的标准口径条目数

# ---------- 可调业务阈值（规则表以 ${VAR} 引用，调参只改这里）----------
# 命名与规则表的对应关系见 config/refund_rules.yaml 头部注释。
# 当前为**已定稿**取值（规则表版本 2026.10-final）；改完重启服务即可生效。
AUTO_AMOUNT_CAP=300        # R1：金额**达到**此上限即转人工（规则用 gte，等于也会命中）
SMALL_AMOUNT=50            # R2 与 R4 共用的小额线（元）
MIN_CREDIT_SCORE=650       # R4：自动通过所需的最低信用分
# R4 与 R5 的退款率门槛取**同一值**，两段衔接、不留"无人区"
MAX_REFUND_RATE=0.20       # R4：自动通过允许的 90 天退款率上限
HIGH_REFUND_RATE=0.20      # R5：判定为高风险的 90 天退款率门槛
HIGH_REFUND_COUNT=6        # R5：判定为高频的 90 天仅退款笔数门槛
# R11：售后时效（天）。已签收 + 签收后超过此天数 + 非质量原因 → 拒绝（驳回）。
REFUND_WINDOW_DAYS=15     # 质量原因超时效仍转人工（质保责任，不走拒绝）
RESHIP_AMOUNT_CAP=200      # R9/R10：补发自动处理上限（元）——达到即转人工

# ---------- 业务库（MySQL，运行于 VM 内 Docker）----------
# 格式：mysql+pymysql://<用户>:<口令>@<VM_IP>:<宿主机映射端口>/<库名>?charset=utf8mb4
# 三个要点：
#   1) host 填 **VM 的 IP + docker 映射到宿主的端口**，不是容器内网地址
#      （除非应用与 MySQL 处于同一 docker 网络）；
#   2) 口令请**直接填在此处**，勿在对话中传递；本文件已被 .gitignore 排除；
#   3) 需要两个账号：业务只读（仅 SELECT）与审计写入（decision_audit 的 INSERT/SELECT）。
# 待填写（口令由你自行写入）：
MYSQL_URI=

# ---------- 审计落库开关 ----------
# true：audit 节点把判定结论写入 MySQL 的 decision_audit 表（建表语句见 sql/decision_audit.sql）
# false：只产出内存审计事件，不触碰数据库（单元测试与离线环境用）
AUDIT_DB_ENABLED=true

# ---------- 检查点库 ----------
# 开发期默认 SQLite（已验证、零依赖）；生产可切 MySQL 社区包
# 切换前置条件：MySQL >= 8.0.19 且 < 9.6.0（>= 9.6.0 时该社区包无迁移路径）
CHECKPOINT_SQLITE_PATH=./data/checkpoints.sqlite
# CHECKPOINT_MYSQL_URI=

# ---------- 腾讯云 COS（举证图片）----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-nanjing
COS_BUCKET=

# ---------- 可插拔适配层（开发 / 生产切换）----------
# 完整设计见 docs/设计_可插拔适配层_v1.md；接口契约见 docs/契约_外部数据源_v1.md。
#
# 数据源模式：
#   留空       自动推断（任一 *_API_BASE 非空即 remote）—— 开发与测试的便利默认
#   local      进程内夹具（演示数据，零外部依赖）
#   remote     真实只读 API
# ⚠️ 生产务必显式写 remote：此时若 *_API_BASE 为空，取数会**明确失败并记 error**，
#    绝不回落到本地夹具 —— 杜绝"以为在用真实数据、其实在读演示数据"。
DATA_SOURCE=

# 对象存储后端：local=本地目录 / cos=腾讯云 COS
# ⚠️ 选 cos 时若 COS_SECRET_ID / KEY / BUCKET 不全，访问存储会直接报错（不会静默回落到本地）
STORAGE_BACKEND=local

# 本地存储根目录（相对 backend/），仅 STORAGE_BACKEND=local 时使用
UPLOAD_DIR=./data/uploads

# 单张上传图片字节上限（超限直接拒绝，不做截断）
UPLOAD_MAX_BYTES=5242880

# ---------- 图像生成（AI 宣传图 · 通义万相）----------
# ⚠️ 留空 = 未开通 / 未配置 → 生图端点会**明确报错**，绝不假装能生成。
#    常用型号：wanx2.1-t2i-turbo（快）· wanx2.1-t2i-plus（精细）· wan2.5-t2i-preview
#    需先在阿里云百炼**开通图像模型**，再把型号填在这里。
#    计费按张算（失败不计费）；生成后图片会**立刻转存**到本地/对象存储
#    —— 官方返回的图片 URL 约 5 分钟就过期，不能直接存进商品表。
IMAGE_MODEL=
# size 必须用**星号**（1024*1024）；写成小写 x 会被判为 InvalidParameter
IMAGE_SIZE=1024*1024
# 异步任务：总等待上限（秒）与轮询间隔
IMAGE_GEN_TIMEOUT=90
IMAGE_POLL_INTERVAL=3

# ---------- 知识库（卖家自建资料 · RAG）----------
# 卖家在页面传政策 / 规则 / 商品资料 → 分块 → 向量化入 Chroma → 助手按需检索并引原文。
# ⚠️ 向量化**按 token 计费**（正常模型调用，成本是配置项，不是设计前提）。
#    密钥复用 DASHSCOPE_API_KEY；图片 OCR 复用「视觉理解」通路（LLM_VISION_MODEL）。
KNOWLEDGE_ENABLED=true
# Chroma 持久化目录（相对 backend/）。**删库＝删这个目录**，不要手工删单个文件
KNOWLEDGE_DIR=./data/knowledge
KNOWLEDGE_COLLECTION=seller_knowledge
# 向量化模型与维度：text-embedding-v3 支持 1024 / 768 / 512
# ⚠️ 改维度（或换模型）**必须重建库** —— 旧向量与查询向量不在同一空间，检索会全错
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# DashScope 的 OpenAI 兼容端点（向量化走它，与对话模型共用同一套密钥）
DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BATCH=10                # v3 单次最多 10 条，超了服务端拒
EMBEDDING_TIMEOUT=15
# 分块：700 字 / 100 字重叠（节内按句子边界切）。参数在**上传时**生效，改了旧资料要重传
KNOWLEDGE_CHUNK_SIZE=700
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_TOP_K=5                 # 默认检索条数（不设相似度阈值，连相关度一起给模型看）
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760   # 单份资料上限 10 MB（超限在解析前拒绝，不截断）

# ---------- 外部业务 API（只读）----------
ORDER_API_BASE=
LOGISTICS_API_BASE=
AFTERSALE_API_BASE=

# ---------- 演示辅助（**非业务能力**；买家界面「演示模式」开关对应此项）----------
# true：允许任意订单号受理——未预置的订单号按订单号**确定性合成**订单/物流/画像事实，
#       让售后链路完整跑通，用于把智能体测透。
# 两条硬边界：① 合成数据一律标注 synthetic，**不伪装成真实数据**；
#            ② 已配置真实业务 API（ORDER_API_BASE / LOGISTICS_API_BASE）时自动失效。
DEMO_ANY_ORDER=true

# ---------- 处置执行（M2：真实资金动作）----------
# **资金安全闸门，非成本项**：SHADOW_MODE=false 且 DISPOSAL_ENABLED=true 才具备执行资格；
#    即便如此，未配置 DISPOSAL_API_BASE 时仍会**拒绝执行并升级人工**。
#    资金动作绝不做"mock 成功"的静默降级——否则会出现"以为退了、其实没退"。
#    执行时会携带 Idempotency-Key（受理号），防止网络重试导致重复退款。
DISPOSAL_ENABLED=false
DISPOSAL_API_BASE=
DISPOSAL_TIMEOUT=5

# ---------- 卖家登录（控制台身份来源；会话按 seller_id 隔离数据）----------
# 会话有效期（小时）。**每次登录都会分配新的助手会话线程** → 每次登录都是新对话
SELLER_SESSION_HOURS=12
# 同一账号连续失败达该次数后锁定（分钟）；计数在进程内，重启即清零（单进程部署的已知边界）
SELLER_LOGIN_MAX_FAILS=5
SELLER_LOGIN_LOCK_MINUTES=10
# 首次启动（账号表为空时）自动创建的账号。**已在库里的账号不会被覆盖**，
# 上线前请把它改掉；要改已存在账号的密码用 backend/scripts/create_seller_account.py
SELLER_BOOTSTRAP_USERNAME=admin
SELLER_BOOTSTRAP_PASSWORD=admin123
SELLER_BOOTSTRAP_NAME=默认卖家
# 该账号绑定的业务数据归属：DDL 默认值 default（与历史数据一致）
SELLER_BOOTSTRAP_SELLER_ID=default

# ---------- 跨域（复核工作台）----------
# 免构建的静态工作台通过 file:// 或独立静态端口打开，与后端不同源，需显式放行 CORS。
# 默认 * 仅限本地开发；生产务必收紧为具体域名（逗号分隔）
CORS_ORIGINS=*

# ---------- 对话入口（P1：买家侧对话智能体）----------
# 默认开启：对话入口即本智能体的主界面（`run.py` 亦默认置 true）。
CHAT_ENABLED=true

# ---------- 对话护栏（产品护栏，按业务需要调整）----------
MAX_ROUNDS=20              # 单会话轮数上限（一个"往返"= 一轮：买家消息 + 智能体回复）
MAX_MSG_CHARS=200          # 单条消息字数上限；首次超长只提示（不计轮次），再犯转人工
MAX_TOOLS_PER_ROUND=3      # 单轮内工具调用次数上限（防模型空转）
MAX_SLOT_ASK=2             # 同一槽位的追问次数上限，仍拿不到即转人工
SESSION_TIMEOUT_HOURS=24   # 会话静默超时（小时）；到期自动收尾或转人工

# ---------- 成本闸门（**配置项**，不是设计前提；用于兜底，不用于限制正常使用）----------
# 三级动作：免费额度优先 → 预警线汇报 → 月度硬上限停止。
# 计量口径为「等效消耗」= token x 官方单价（免费额度期内实际扣费为 0）。
COST_WARNING_CNY=20        # 预警线（元）：达到即汇报当月消耗（默认取月度上限的 10%）
COST_MONTHLY_CAP_CNY=200   # 月度硬上限（元）：达到即停用对话入口（转人工兜底）
FREE_QUOTA_TOKENS=1000000  # **单个模型**的免费额度（token）；判定只比当前 LLM_TEXT_MODEL 的用量，换模型无需改这里
# 单价（元 / 1K token）——**可选项**，按官方价填；本项目不臆造价格。
# 留 0 即成本闸门只按 token 计量：**这是正常状态，不是待补的配置缺陷**，不会触发任何告警。
PRICE_INPUT_PER_1K=0
PRICE_OUTPUT_PER_1K=0

# ---------- 免费额度兜底（**外部事实，非项目设计**）----------
# 额度总量 / 到期日 / 已用量都是**特定模型或账号的外部事实**，不是项目设计的一部分；
# 换模型或换账号即失效，故默认留空 / 0。只在确有需要时按当时实际情况填。
# 说明：它们只影响闸门判定，**不构成"少用模型"的理由**——模型按正常业务使用。
FREE_QUOTA_EXPIRE_DATE=        # 额度到期日，形如 2026-10-31；留空 = 不做到期判定
FREE_QUOTA_USED_BASELINE=0     # 官方控制台显示的**该模型**外部已用量；真实已用 = 本值 + 本项目该模型累计
